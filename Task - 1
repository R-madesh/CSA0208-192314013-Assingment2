
#include <stdio.h>
#include "billing.h"

void calculateBill(unsigned long units)
{
    long long amount;

    if (units <= FREE_LIMIT)
        amount = FIXED_CHARGE;
    else if (units <= SLAB_LIMIT)
        amount = FIXED_CHARGE +
                 (long long)(units - FREE_LIMIT) * RATE_1;
    else
        amount = FIXED_CHARGE +
                 100LL * RATE_1 +
                 (long long)(units - SLAB_LIMIT) * RATE_2;

#ifdef DEBUG
    printf("DEBUG: Units = %lu\n", units);
    printf("DEBUG: Bill in paise = %lld\n", amount);
#endif

    printBill(units, amount);
}

void printBill(unsigned long units, long long amount)
{
    printf("\n--- ELECTRICITY BILL ---\n");
    printf("Units consumed: %lu\n", units);
    printf("Total bill: Rs %lld.%02lld\n",
           amount / 100, amount % 100);
}

int main(void)
{
    unsigned long previous, current, units;
 
    if (scanf("%lu", &previous) != 1)
    {
        printf("Invalid input!\n");
        return 1;
    }
 
    if (scanf("%lu", &current) != 1)
    {
        printf("Invalid input!\n");
        return 1;
    }

    if (previous > 65535 || current > 65535)
    {
        printf("Invalid meter reading!\n");
        return 1;
    }

    if (current >= previous)
        units = current - previous;
    else if (current == 0)
        units = 65536UL - previous;
    else
    {
        printf("Invalid meter rollover!\n");
        return 1;
    }

    calculateBill(units);
    return 0;
}
